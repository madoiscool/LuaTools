<UserControl
    x:Class="GameGuy.Views.OnboardingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:res="clr-namespace:GameGuy.Resources"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:GameGuy.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:OnboardingViewModel}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!-- Segmented Yes/No button: Primary when its bound bool matches this button's value. -->
        <Style x:Key="ChoiceButton" BasedOn="{StaticResource {x:Type ui:Button}}" TargetType="ui:Button">
            <Setter Property="MinWidth" Value="92" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <!-- Dim scrim + centered welcome card (in-window overlay, not a Popup). Visibility is controlled by
         the host in MainWindow via Onboarding.IsOpen. -->
    <Grid Background="#66000000">
        <Border
            MaxWidth="640"
            Margin="16"
            Padding="30,32"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="#1c1c22"
            BorderBrush="#33FFFFFF"
            BorderThickness="1"
            CornerRadius="14">
            <StackPanel>
                <!-- Title -->
                <TextBlock
                    FontSize="21"
                    FontWeight="Bold"
                    Text="{x:Static res:Strings.Onboarding_Title}"
                    TextWrapping="Wrap" />

                <!-- Authentication key (asked once; hidden if one is already stored) -->
                <StackPanel Visibility="{Binding NeedsAuthKey, Converter={StaticResource BoolToVis}}">
                    <TextBlock
                        Margin="0,16,0,0"
                        FontSize="13"
                        Foreground="#9ca3af"
                        Text="{x:Static res:Strings.Onboarding_AuthKey_Blurb}"
                        TextWrapping="Wrap" />
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox
                            FontFamily="Consolas"
                            PlaceholderText="{x:Static res:Strings.Settings_AuthKeyPlaceholder}"
                            Text="{Binding AuthKeyInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <ui:Button
                            Grid.Column="1"
                            Margin="8,0,0,0"
                            Appearance="Primary"
                            Command="{Binding SaveAuthKeyCommand}"
                            Content="{x:Static res:Strings.Settings_AuthKey_Save}"
                            Icon="{ui:SymbolIcon Key24}"
                            IsEnabled="{Binding CanSaveAuthKey}" />
                    </Grid>
                    <TextBlock
                        Margin="0,8,0,0"
                        FontSize="11.5"
                        Foreground="#f87171"
                        Text="{Binding StatusLine}"
                        TextWrapping="Wrap"
                        Visibility="{Binding StatusLine, Converter={StaticResource NullToCollapsed}}" />
                </StackPanel>
                <!-- Key saved confirmation -->
                <TextBlock
                    Margin="0,16,0,0"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="#4ade80"
                    Text="{x:Static res:Strings.Onboarding_AuthKeySet}"
                    Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVis}}" />

                <StackPanel Visibility="{Binding ShowChoices, Converter={StaticResource BoolToVis}}">
                <Border Height="1" Margin="0,24,0,0" Background="#1FFFFFFF" />

                <!-- Apply recommended settings -->
                <Grid Margin="0,24,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,28,0" VerticalAlignment="Center">
                        <TextBlock FontSize="14" FontWeight="SemiBold" Text="{x:Static res:Strings.Onboarding_Recommended_Title}" />
                        <TextBlock Margin="0,2,0,0" FontSize="12" Foreground="#7c8593" Text="{x:Static res:Strings.Onboarding_Recommended_Detail}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                        <ui:Button Command="{Binding SetApplyRecommendedCommand}" Content="{x:Static res:Strings.Onboarding_Yes}">
                            <ui:Button.CommandParameter><sys:Boolean>True</sys:Boolean></ui:Button.CommandParameter>
                            <ui:Button.Style>
                                <Style BasedOn="{StaticResource ChoiceButton}" TargetType="ui:Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ApplyRecommended}" Value="True">
                                            <Setter Property="Appearance" Value="Primary" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:Button.Style>
                        </ui:Button>
                        <ui:Button Command="{Binding SetApplyRecommendedCommand}" Content="{x:Static res:Strings.Onboarding_No}">
                            <ui:Button.CommandParameter><sys:Boolean>False</sys:Boolean></ui:Button.CommandParameter>
                            <ui:Button.Style>
                                <Style BasedOn="{StaticResource ChoiceButton}" TargetType="ui:Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ApplyRecommended}" Value="False">
                                            <Setter Property="Appearance" Value="Primary" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:Button.Style>
                        </ui:Button>
                    </StackPanel>
                </Grid>

                <!-- Install plugin -->
                <Grid Margin="0,22,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,28,0" VerticalAlignment="Center">
                        <TextBlock FontSize="14" FontWeight="SemiBold" Text="{x:Static res:Strings.Onboarding_Plugin_Title}" />
                        <TextBlock Margin="0,2,0,0" FontSize="12" Foreground="#7c8593" Text="{x:Static res:Strings.Onboarding_Plugin_Detail}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                        <ui:Button Command="{Binding SetInstallPluginCommand}" Content="{x:Static res:Strings.Onboarding_Yes}">
                            <ui:Button.CommandParameter><sys:Boolean>True</sys:Boolean></ui:Button.CommandParameter>
                            <ui:Button.Style>
                                <Style BasedOn="{StaticResource ChoiceButton}" TargetType="ui:Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding InstallPlugin}" Value="True">
                                            <Setter Property="Appearance" Value="Primary" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:Button.Style>
                        </ui:Button>
                        <ui:Button Command="{Binding SetInstallPluginCommand}" Content="{x:Static res:Strings.Onboarding_No}">
                            <ui:Button.CommandParameter><sys:Boolean>False</sys:Boolean></ui:Button.CommandParameter>
                            <ui:Button.Style>
                                <Style BasedOn="{StaticResource ChoiceButton}" TargetType="ui:Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding InstallPlugin}" Value="False">
                                            <Setter Property="Appearance" Value="Primary" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:Button.Style>
                        </ui:Button>
                    </StackPanel>
                </Grid>
                </StackPanel>

                <!-- Let's go! -->
                <ui:Button
                    Margin="0,28,0,0"
                    Padding="0,10"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Appearance="Primary"
                    Command="{Binding FinishCommand}"
                    Content="{x:Static res:Strings.Onboarding_Go}"
                    FontSize="14"
                    IsEnabled="{Binding CanFinish}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
