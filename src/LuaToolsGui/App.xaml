<Application x:Class="LuaToolsGui.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:conv="clr-namespace:LuaToolsGui"
    ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters -->
            <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
            <conv:NullToCollapsedConverter x:Key="NullToCollapsed" />
            <conv:StatusToBrushConverter x:Key="StatusToBrush" />
            <conv:ImagePathToSourceConverter x:Key="ImagePathToSource" />
            <conv:EqualityMultiConverter x:Key="EqualityMulti" />
            <conv:MinHeightToVisibilityConverter x:Key="MinHeightToVis" />
            <conv:FilterOptionDisplayConverter x:Key="FilterOptionDisplay" />
            <conv:EnumEqualsConverter x:Key="EnumEquals" />
            <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
