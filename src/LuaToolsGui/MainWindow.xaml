<ui:FluentWindow
    x:Class="LuaToolsGui.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:res="clr-namespace:LuaToolsGui.Resources"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:LuaToolsGui.ViewModels"
    xmlns:views="clr-namespace:LuaToolsGui.Views"
    Title="LuaTools"
    Icon="icon.ico"
    Width="1080"
    Height="720"
    MinWidth="760"
    MinHeight="560"
    d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="LuaTools">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/icon.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1">
            <!-- App content (nav rail + toasts). Blurred while the first-run welcome overlay is open. -->
            <Grid x:Name="AppContent">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Onboarding.IsOpen}" Value="True">
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <BlurEffect KernelType="Gaussian" Radius="28" RenderingBias="Performance" />
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
            <!-- Fluent nav rail. Selection/highlight + page hosting are handled by the control. -->
            <ui:NavigationView
                x:Name="RootNavigation"
                IsBackButtonVisible="Collapsed"
                IsPaneToggleVisible="False"
                OpenPaneLength="190"
                PaneDisplayMode="Left">
                <ui:NavigationView.MenuItems>
                    <ui:NavigationViewItem Content="{x:Static res:Strings.Nav_Home}" TargetPageType="{x:Type views:HomeView}">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="Home24" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                    <ui:NavigationViewItem Content="{x:Static res:Strings.Nav_Add}" TargetPageType="{x:Type views:DownloadView}">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="Add24" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                    <ui:NavigationViewItem Content="{x:Static res:Strings.Nav_Manage}" TargetPageType="{x:Type views:ManageView}">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="Games24" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                    <ui:NavigationViewItem Content="{x:Static res:Strings.Nav_Builds}" TargetPageType="{x:Type views:BuildsView}">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="BranchFork24" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                    <ui:NavigationViewItem Content="{x:Static res:Strings.Nav_Achievements}" TargetPageType="{x:Type views:AchievementsView}">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="Trophy24" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                    <ui:NavigationViewItem Content="{x:Static res:Strings.Nav_Mode}" TargetPageType="{x:Type views:ModeView}">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="Options24" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                    <ui:NavigationViewItem Content="{x:Static res:Strings.Nav_Fixes}" TargetPageType="{x:Type views:FixesView}">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="ShieldTask24" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                    <ui:NavigationViewItem Content="Plugin" TargetPageType="{x:Type views:PluginView}">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="PuzzlePiece24" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                </ui:NavigationView.MenuItems>

                <ui:NavigationView.FooterMenuItems>
                    <ui:NavigationViewItem Content="{x:Static res:Strings.Nav_RestartSteam}" Click="RestartSteam_Click">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="ArrowClockwise24" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                    <ui:NavigationViewItem Content="{x:Static res:Strings.Nav_Settings}" TargetPageType="{x:Type views:SettingsView}">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="Settings24" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                </ui:NavigationView.FooterMenuItems>

                <!-- Guest sign-in CTA + always-visible version tag at the very bottom of the pane -->
                <ui:NavigationView.PaneFooter>
                  <StackPanel>
                    <StackPanel
                        Margin="10,4,10,8"
                        Visibility="{Binding IsGuest, Converter={StaticResource BoolToVis}}">
                        <ui:Button
                            HorizontalAlignment="Stretch"
                            Appearance="Primary"
                            Command="{Binding SignInCommand}"
                            Content="{x:Static res:Strings.Nav_SignInDiscord}"
                            Icon="{ui:SymbolIcon Person24}"
                            Visibility="{Binding IsSigningIn, Converter={StaticResource InverseBoolToVis}}" />
                        <StackPanel
                            HorizontalAlignment="Center"
                            Orientation="Horizontal"
                            Visibility="{Binding IsSigningIn, Converter={StaticResource BoolToVis}}">
                            <ui:ProgressRing
                                Width="16"
                                Height="16"
                                IsIndeterminate="True" />
                            <TextBlock
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="11.5"
                                Foreground="#9ca3af"
                                Text="{x:Static res:Strings.Nav_WaitingForBrowser}" />
                        </StackPanel>
                        <TextBlock
                            Margin="2,8,0,0"
                            FontSize="11.5"
                            Foreground="#f87171"
                            Text="{Binding SignInError}"
                            TextWrapping="Wrap"
                            Visibility="{Binding SignInError, Converter={StaticResource NullToCollapsed}}" />
                    </StackPanel>

                    <!-- Bottom line: "Signed in as …" when logged in, else the version tag. -->
                    <TextBlock
                        Margin="12,0,10,8"
                        FontSize="11"
                        Foreground="#6b7280"
                        Text="{Binding FooterStatus}"
                        TextTrimming="CharacterEllipsis"
                        ToolTip="{Binding FooterStatus}" />
                  </StackPanel>
                </ui:NavigationView.PaneFooter>
            </ui:NavigationView>

            <!-- Bottom-right toasts (attached to ToastService in App.OnStartup). Also hosts the
                 persistent "update ready" prompt with a Restart action. -->
            <ui:SnackbarPresenter
                x:Name="RootSnackbar"
                Margin="0,0,24,18"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom" />
            </Grid>

            <!-- First-run welcome overlay (last child = top Z-order; covers the nav + page area). -->
            <views:OnboardingView
                DataContext="{Binding Onboarding}"
                Visibility="{Binding IsOpen, Converter={StaticResource BoolToVis}}" />
        </Grid>
    </Grid>
</ui:FluentWindow>
