<UserControl
    x:Class="LuaToolsGui.Views.DownloadView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:res="clr-namespace:LuaToolsGui.Resources"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:views="clr-namespace:LuaToolsGui.Views"
    xmlns:vm="clr-namespace:LuaToolsGui.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:DownloadViewModel}"
    TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!-- One diff row: clickable → SteamDB. Real name on top, "id · size · OS · lang" below, DLC/SHARED chip right. -->
        <DataTemplate x:Key="DiffRowTemplate">
            <Button
                Margin="0,0,0,2"
                Padding="6,4"
                HorizontalContentAlignment="Stretch"
                Background="Transparent"
                BorderThickness="0"
                Command="{Binding DataContext.OpenSteamDbCommand, ElementName=Root}"
                CommandParameter="{Binding}"
                Cursor="Hand"
                ToolTip="{x:Static res:Strings.Confirm_OpenSteamDb}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Bd"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock
                                        FontSize="12.5"
                                        Foreground="#e5e7eb"
                                        Text="{Binding Title}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Margin="0,1,0,0"
                                        FontSize="10.5"
                                        Foreground="#6b7280"
                                        Text="{Binding Meta}" />
                                </StackPanel>
                                <Border
                                    Grid.Column="1"
                                    Margin="8,1,0,0"
                                    Padding="5,1"
                                    VerticalAlignment="Top"
                                    Background="#2a2440"
                                    CornerRadius="4"
                                    Visibility="{Binding IsDlc, Converter={StaticResource BoolToVis}}">
                                    <TextBlock
                                        FontSize="9.5"
                                        FontWeight="SemiBold"
                                        Foreground="#c4b5fd"
                                        Text="DLC" />
                                </Border>
                                <Border
                                    Grid.Column="1"
                                    Margin="8,1,0,0"
                                    Padding="5,1"
                                    VerticalAlignment="Top"
                                    Background="#3a3320"
                                    CornerRadius="4"
                                    Visibility="{Binding IsShared, Converter={StaticResource BoolToVis}}">
                                    <TextBlock
                                        FontSize="9.5"
                                        FontWeight="SemiBold"
                                        Foreground="#d6b36b"
                                        Text="{x:Static res:Strings.Confirm_Shared}" />
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#14FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>

        <!-- One featured card: wide capsule art + name; whole card is a button. Shared by both rows. -->
        <DataTemplate x:Key="FeaturedCardTemplate">
            <Button
                Width="190"
                Margin="0,0,10,0"
                Padding="0"
                HorizontalContentAlignment="Stretch"
                Background="Transparent"
                BorderThickness="0"
                Command="{Binding DataContext.SelectFeaturedCommand, ElementName=Root}"
                CommandParameter="{Binding}"
                Cursor="Hand"
                ToolTip="{Binding Name}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Bd"
                            Background="#0DFFFFFF"
                            BorderBrush="#14FFFFFF"
                            BorderThickness="1"
                            CornerRadius="8">
                            <StackPanel>
                                <Border CornerRadius="7,7,0,0">
                                    <Image
                                        Height="89"
                                        Source="{Binding Image}"
                                        Stretch="UniformToFill" />
                                </Border>
                                <TextBlock
                                    Height="34"
                                    Margin="8,6,8,8"
                                    FontSize="12"
                                    Foreground="#d1d5db"
                                    Text="{Binding Name}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1AFFFFFF" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#33a78bfa" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <Grid x:Name="Root">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="640" Margin="8,16,8,24">

            <TextBlock
                FontSize="22"
                FontWeight="Bold"
                Text="{x:Static res:Strings.Add_Title}" />
            <TextBlock
                Margin="0,4,0,16"
                FontSize="13"
                Foreground="#9ca3af"
                Text="{x:Static res:Strings.Add_Subtitle}" />

            <!-- Search -->
            <ui:TextBox
                Icon="{ui:SymbolIcon Search24}"
                PlaceholderText="{x:Static res:Strings.Add_SearchPlaceholder}"
                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

            <!-- Autocomplete results -->
            <Border
                Margin="0,6,0,0"
                Background="#14141c"
                BorderBrush="#14FFFFFF"
                BorderThickness="1"
                CornerRadius="10"
                Visibility="{Binding IsResultsOpen, Converter={StaticResource BoolToVis}}">
                <ItemsControl ItemsSource="{Binding SearchResults}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Background="Transparent"
                                BorderThickness="0"
                                Command="{Binding DataContext.SelectResultCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Cursor="Hand">
                                <Grid Margin="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        Width="60"
                                        Height="28"
                                        CornerRadius="4">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding Icon}" Stretch="UniformToFill" />
                                        </Border.Background>
                                    </Border>
                                    <TextBlock
                                        Grid.Column="1"
                                        Margin="10,0"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        Text="{Binding Name}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        FontSize="11.5"
                                        Foreground="#6b7280"
                                        Text="{Binding AppId}" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- Featured rows (Steam top-sellers / new-releases). Idle-only: the whole block hides once you
                 search or pick a game. Two stacked labeled rows, each a horizontally-scrolling card strip. -->
            <StackPanel
                Margin="0,18,0,0"
                Visibility="{Binding ShowFeatured, Converter={StaticResource BoolToVis}}">

                <!-- Top Sellers row -->
                <StackPanel Visibility="{Binding HasTopSellers, Converter={StaticResource BoolToVis}}">
                    <TextBlock
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="#d1d5db"
                        Text="{x:Static res:Strings.Add_Featured_TopSellers}" />
                    <ScrollViewer
                        Margin="0,8,0,0"
                        HorizontalScrollBarVisibility="Auto"
                        PreviewMouseWheel="FeaturedStrip_PreviewMouseWheel"
                        VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemTemplate="{StaticResource FeaturedCardTemplate}" ItemsSource="{Binding TopSellers}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>

                <!-- New Releases row -->
                <StackPanel Margin="0,16,0,0" Visibility="{Binding HasNewReleases, Converter={StaticResource BoolToVis}}">
                    <TextBlock
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="#d1d5db"
                        Text="{x:Static res:Strings.Add_Featured_NewReleases}" />
                    <ScrollViewer
                        Margin="0,8,0,0"
                        HorizontalScrollBarVisibility="Auto"
                        PreviewMouseWheel="FeaturedStrip_PreviewMouseWheel"
                        VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemTemplate="{StaticResource FeaturedCardTemplate}" ItemsSource="{Binding NewReleases}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </StackPanel>

            <!-- Game info card -->
            <Border
                Margin="0,14,0,0"
                Background="#0DFFFFFF"
                BorderBrush="#12FFFFFF"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="{Binding HasDetails, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <Border
                        MaxHeight="180"
                        CornerRadius="8,8,0,0">
                        <Image Source="{Binding Details.HeaderImage}" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel Margin="12,8,12,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                FontSize="14.5"
                                FontWeight="SemiBold"
                                Text="{Binding Details.Name}" />
                            <Border
                                Margin="8,0,0,0"
                                Padding="6,1.5"
                                VerticalAlignment="Center"
                                Background="#26a78bfa"
                                BorderBrush="#40a78bfa"
                                BorderThickness="1"
                                CornerRadius="4"
                                Visibility="{Binding Details.IsDlc, Converter={StaticResource BoolToVis}}">
                                <TextBlock
                                    FontSize="10.5"
                                    FontWeight="SemiBold"
                                    Foreground="#a78bfa"
                                    Text="DLC" />
                            </Border>
                        </StackPanel>
                        <TextBlock
                            Margin="0,3,0,0"
                            FontSize="11.5"
                            Foreground="#6b7280">
                            <Run Text="{Binding Details.AppId, Mode=OneWay}" />
                            <Run Text=" · " />
                            <Run Text="{Binding GenresText, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock
                            FontSize="11"
                            Foreground="#4b5563"
                            Text="{Binding Details.ReleaseDate, StringFormat={x:Static res:Strings.Add_Released}}"
                            Visibility="{Binding Details.ReleaseDate, Converter={StaticResource NullToCollapsed}}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- FastFetch toggle -->
            <Grid
                Margin="0,12,0,0"
                Visibility="{Binding HasDetails, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock
                        FontSize="13"
                        FontWeight="Medium"
                        Text="{x:Static res:Strings.Add_FastFetch}" />
                    <TextBlock
                        FontSize="11"
                        Foreground="#6b7280"
                        Text="{x:Static res:Strings.Add_FastFetch_Hint}" />
                </StackPanel>
                <ui:ToggleSwitch
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    IsChecked="{Binding FastFetch, Mode=TwoWay}" />
            </Grid>

            <!-- Fetch button -->
            <ui:Button
                Margin="0,14,0,0"
                HorizontalAlignment="Stretch"
                Appearance="Primary"
                Command="{Binding FetchCommand}"
                Icon="{ui:SymbolIcon ArrowDownload24}"
                Visibility="{Binding HasDetails, Converter={StaticResource BoolToVis}}">
                <ui:Button.Content>
                    <Grid>
                        <TextBlock Text="{x:Static res:Strings.Add_Fetch}" Visibility="{Binding IsChecking, Converter={StaticResource InverseBoolToVis}}" />
                        <TextBlock Text="{x:Static res:Strings.Add_Checking}" Visibility="{Binding IsChecking, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                </ui:Button.Content>
            </ui:Button>

            <!-- Error -->
            <TextBlock
                Margin="0,12,0,0"
                FontSize="13"
                Foreground="#f87171"
                Text="{Binding Error}"
                TextWrapping="Wrap"
                Visibility="{Binding Error, Converter={StaticResource NullToCollapsed}}" />

            <!-- Denuvo fix banner: shown after a Fetch when the game has published fixes. Purple, so it
                 reads as an offer rather than a result (green) or a problem (amber). -->
            <Border
                Margin="0,12,0,0"
                Padding="12,9"
                Background="#14a78bfa"
                BorderBrush="#40a78bfa"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="{Binding HasFix, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon
                        VerticalAlignment="Center"
                        Foreground="#a78bfa"
                        Symbol="ShieldTask24" />
                    <TextBlock
                        Grid.Column="1"
                        Margin="10,0"
                        VerticalAlignment="Center"
                        FontSize="13"
                        Text="{Binding FixBannerText}"
                        TextWrapping="Wrap" />
                    <ui:Button
                        Grid.Column="2"
                        Appearance="Primary"
                        Command="{Binding OpenFixesCommand}"
                        Content="{x:Static res:Strings.Add_Fix_Open}"
                        Icon="{ui:SymbolIcon ShieldTask24}" />
                </Grid>
            </Border>

            <!-- Install result banner (green on success, amber on partial/failed) -->
            <Border
                Margin="0,12,0,0"
                Padding="12,9"
                CornerRadius="8"
                Visibility="{Binding HasInstallResult, Converter={StaticResource BoolToVis}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#1422c55e" />
                        <Setter Property="BorderBrush" Value="#4022c55e" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding InstallFailed}" Value="True">
                                <Setter Property="Background" Value="#14f0a868" />
                                <Setter Property="BorderBrush" Value="#40f0a868" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon VerticalAlignment="Center">
                        <ui:SymbolIcon.Style>
                            <Style TargetType="ui:SymbolIcon">
                                <!-- Success: green check. Failure: orange warning (matches the banner tint). -->
                                <Setter Property="Foreground" Value="#22c55e" />
                                <Setter Property="Symbol" Value="CheckmarkCircle24" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding InstallFailed}" Value="True">
                                        <Setter Property="Foreground" Value="#f0a868" />
                                        <Setter Property="Symbol" Value="Warning24" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:SymbolIcon.Style>
                    </ui:SymbolIcon>
                    <TextBlock
                        Grid.Column="1"
                        Margin="10,0"
                        VerticalAlignment="Center"
                        FontSize="13"
                        Text="{Binding InstallStatus}"
                        TextWrapping="Wrap" />
                    <!-- Reveal only makes sense on a successful install. -->
                    <ui:Button
                        Grid.Column="2"
                        Command="{Binding RevealInstalledCommand}"
                        Content="{x:Static res:Strings.Add_Reveal}"
                        Icon="{ui:SymbolIcon FolderOpen24}"
                        Visibility="{Binding InstallFailed, Converter={StaticResource InverseBoolToVis}}" />
                </Grid>
            </Border>

            <!-- Manifest sources -->
            <ItemsControl
                Margin="0,12,0,0"
                ItemsSource="{Binding Sources}"
                Visibility="{Binding HasSources, Converter={StaticResource BoolToVis}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Margin="0,0,0,8"
                            Padding="12,9"
                            Background="#08FFFFFF"
                            BorderBrush="#12FFFFFF"
                            BorderThickness="1"
                            CornerRadius="8">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                        <TextBlock
                                            FontSize="13.5"
                                            FontWeight="Medium"
                                            Text="{Binding DisplayName}" />
                                        <ui:SymbolIcon
                                            Margin="6,0,0,0"
                                            FontSize="15"
                                            Foreground="#eab308"
                                            Symbol="Key24"
                                            ToolTip="{x:Static res:Strings.Add_RequiresOwnKey}"
                                            Visibility="{Binding NeedsKey, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>

                                    <!-- Usage + supporter badges -->
                                    <StackPanel
                                        Grid.Column="1"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal">
                                        <Border
                                            Padding="6,2"
                                            Background="#1422c55e"
                                            BorderBrush="#3022c55e"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Visibility="{Binding StatsText, Converter={StaticResource NullToCollapsed}}">
                                            <TextBlock
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                Foreground="#22c55e"
                                                Text="{Binding StatsText}" />
                                        </Border>
                                        <Border
                                            Margin="4,0,0,0"
                                            Padding="5,1"
                                            Background="#20f59e0b"
                                            CornerRadius="4"
                                            Visibility="{Binding IsSupporter, Converter={StaticResource BoolToVis}}">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon
                                                    FontSize="10"
                                                    Foreground="#f59e0b"
                                                    Symbol="Star24" />
                                                <TextBlock
                                                    Margin="3,0,0,0"
                                                    FontSize="10"
                                                    FontWeight="SemiBold"
                                                    Foreground="#f59e0b"
                                                    Text="{x:Static res:Strings.Add_Supporter}" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- Status badge -->
                                    <Border
                                        Grid.Column="2"
                                        Margin="0,0,8,0"
                                        Padding="6,2"
                                        VerticalAlignment="Center"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Visibility="{Binding ShowStatus, Converter={StaticResource BoolToVis}}">
                                        <Border.BorderBrush>
                                            <Binding Converter="{StaticResource StatusToBrush}" Path="Status" />
                                        </Border.BorderBrush>
                                        <TextBlock
                                            FontSize="10.5"
                                            FontWeight="SemiBold"
                                            Foreground="{Binding Status, Converter={StaticResource StatusToBrush}}"
                                            Text="{Binding StatusLabel}" />
                                    </Border>

                                    <ui:Button
                                        Grid.Column="3"
                                        Margin="0,0,8,0"
                                        Padding="8,5"
                                        Command="{Binding OpenDiscordCommand}"
                                        Content="{x:Static res:Strings.Add_Discord}"
                                        FontSize="11.5"
                                        ToolTip="{x:Static res:Strings.Add_JoinDiscord}"
                                        Visibility="{Binding DiscordUrl, Converter={StaticResource NullToCollapsed}}" />

                                    <ui:Button
                                        Grid.Column="4"
                                        Appearance="Primary"
                                        Command="{Binding DownloadCommand}"
                                        Content="{x:Static res:Strings.Add_Download}"
                                        Icon="{ui:SymbolIcon ArrowDownload24}"
                                        Visibility="{Binding CanDownload, Converter={StaticResource BoolToVis}}" />

                                    <!-- Key-gated and not configured -->
                                    <TextBlock
                                        Grid.Column="4"
                                        VerticalAlignment="Center"
                                        FontSize="11.5"
                                        Foreground="#a78bfa"
                                        Text="{x:Static res:Strings.Add_NeedsHubcapKey}"
                                        ToolTip="{x:Static res:Strings.Add_NeedsHubcapKey_Tip}"
                                        Visibility="{Binding IsLocked, Converter={StaticResource BoolToVis}}" />
                                </Grid>

                                <ProgressBar
                                    Margin="0,8,0,0"
                                    IsIndeterminate="{Binding IsProgressIndeterminate}"
                                    Maximum="100"
                                    Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}"
                                    Value="{Binding Progress, Mode=OneWay}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- DLC info -->
            <StackPanel Margin="0,12,0,0" Visibility="{Binding HasDlcInfo, Converter={StaticResource BoolToVis}}">
                <!-- Stat tiles -->
                <UniformGrid Columns="3">
                    <Border
                        Margin="0,0,4,0"
                        Padding="0,10"
                        Background="#08FFFFFF"
                        BorderBrush="#12FFFFFF"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="20"
                                FontWeight="Bold"
                                Foreground="#a78bfa"
                                Text="{Binding DlcInfo.DepotCount}" />
                            <TextBlock
                                FontSize="11"
                                Foreground="#6b7280"
                                Text="{x:Static res:Strings.Add_Depots}" />
                        </StackPanel>
                    </Border>
                    <Border
                        Margin="4,0"
                        Padding="0,10"
                        Background="#08FFFFFF"
                        BorderBrush="#12FFFFFF"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="20"
                                FontWeight="Bold"
                                Foreground="#22c55e"
                                Text="{Binding DlcInfo.HaveCount}" />
                            <TextBlock
                                FontSize="11"
                                Foreground="#6b7280"
                                Text="{x:Static res:Strings.Add_Available}" />
                        </StackPanel>
                    </Border>
                    <Border
                        Margin="4,0,0,0"
                        Padding="0,10"
                        Background="#08FFFFFF"
                        BorderBrush="#12FFFFFF"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="20"
                                FontWeight="Bold"
                                Foreground="#f97316"
                                Text="{Binding DlcInfo.MissingCount}" />
                            <TextBlock
                                FontSize="11"
                                Foreground="#6b7280"
                                Text="{x:Static res:Strings.Add_Missing}" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Depot list -->
                <ItemsControl
                    MaxHeight="220"
                    Margin="0,10,0,0"
                    ItemsSource="{Binding DlcDepots}">
                    <ItemsControl.Template>
                        <ControlTemplate TargetType="ItemsControl">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Margin="0,0,0,5"
                                Padding="10,6"
                                BorderThickness="1"
                                CornerRadius="6">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#0Ff97316" />
                                        <Setter Property="BorderBrush" Value="#38f97316" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Included}" Value="True">
                                                <Setter Property="Background" Value="#0F22c55e" />
                                                <Setter Property="BorderBrush" Value="#2E22c55e" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        FontFamily="Consolas"
                                        FontSize="12.5"
                                        Text="{Binding DepotId}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Margin="0,0,10,0"
                                        FontSize="11"
                                        Foreground="#6b7280"
                                        Text="{Binding Meta}" />
                                    <TextBlock
                                        Grid.Column="2"
                                        FontSize="10.5"
                                        FontWeight="Bold"
                                        Foreground="#f97316"
                                        Text="{x:Static res:Strings.Add_NoKey}"
                                        Visibility="{Binding Included, Converter={StaticResource InverseBoolToVis}}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Generate -->
                <ui:Button
                    Margin="0,10,0,0"
                    HorizontalAlignment="Stretch"
                    Appearance="Primary"
                    Command="{Binding GenerateDlcCommand}"
                    Icon="{ui:SymbolIcon ArrowDownload24}"
                    Visibility="{Binding CanGenerateDlc, Converter={StaticResource BoolToVis}}">
                    <ui:Button.Content>
                        <Grid>
                            <TextBlock Text="{x:Static res:Strings.Add_DownloadLua}" Visibility="{Binding IsGenerating, Converter={StaticResource InverseBoolToVis}}" />
                            <TextBlock Text="{x:Static res:Strings.Add_Generating}" Visibility="{Binding IsGenerating, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                    </ui:Button.Content>
                </ui:Button>
                <TextBlock
                    Margin="0,8,0,0"
                    HorizontalAlignment="Center"
                    FontSize="11.5"
                    Foreground="#6b7280"
                    Text="{x:Static res:Strings.Add_DlcHint}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>

            <!-- Already have files? Drag them in -->
            <TextBlock
                Margin="0,24,0,0"
                FontSize="13"
                FontWeight="SemiBold"
                Foreground="#d1d5db"
                Text="{x:Static res:Strings.Add_AlreadyHaveFiles}" />
            <views:DropZone Margin="0,8,0,0" DataContext="{Binding Drop}" />
        </StackPanel>
    </ScrollViewer>

    <!-- Overwrite confirm: dim scrim + centered before/after diff -->
    <Grid
        Background="#99000000"
        Visibility="{Binding IsConfirmingOverwrite, Converter={StaticResource BoolToVis}}">
        <Border
            Width="460"
            MaxHeight="560"
            Margin="24"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="#1c1c22"
            BorderBrush="#33FFFFFF"
            BorderThickness="1"
            CornerRadius="12">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock
                    FontSize="17"
                    FontWeight="Bold"
                    Text="{Binding ConfirmTitle}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Grid.Row="1"
                    Margin="0,4,0,0"
                    FontSize="12"
                    Foreground="#9ca3af"
                    Text="{x:Static res:Strings.Confirm_ReviewChanges}" />

                <ScrollViewer
                    Grid.Row="2"
                    Margin="0,14,0,0"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- No changes note -->
                        <TextBlock
                            FontSize="12.5"
                            Foreground="#6b7280"
                            Text="{Binding ConfirmNoChanges}"
                            TextWrapping="Wrap"
                            Visibility="{Binding ConfirmNoChanges, Converter={StaticResource NullToCollapsed}}" />

                        <!-- Adding -->
                        <StackPanel Visibility="{Binding HasDiffAdded, Converter={StaticResource BoolToVis}}">
                            <TextBlock
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="#34d399"
                                Text="{Binding DiffAdded.Count, StringFormat={x:Static res:Strings.Confirm_Adding}}" />
                            <ItemsControl
                                Margin="0,6,0,0"
                                ItemTemplate="{StaticResource DiffRowTemplate}"
                                ItemsSource="{Binding DiffAdded}" />
                        </StackPanel>

                        <!-- Removing -->
                        <StackPanel Margin="0,10,0,0" Visibility="{Binding HasDiffRemoved, Converter={StaticResource BoolToVis}}">
                            <TextBlock
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="#f0a868"
                                Text="{Binding DiffRemoved.Count, StringFormat={x:Static res:Strings.Confirm_Removing}}" />
                            <ItemsControl
                                Margin="0,6,0,0"
                                ItemTemplate="{StaticResource DiffRowTemplate}"
                                ItemsSource="{Binding DiffRemoved}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- Actions -->
                <StackPanel
                    Grid.Row="3"
                    Margin="0,16,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
                    <ui:Button
                        Margin="0,0,8,0"
                        Command="{Binding CancelOverwriteCommand}"
                        Content="{x:Static res:Strings.Mode_Cancel}" />
                    <ui:Button
                        Appearance="Primary"
                        Command="{Binding ConfirmOverwriteCommand}"
                        Content="{x:Static res:Strings.Confirm_Replace}"
                        Icon="{ui:SymbolIcon ArrowDownload24}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>

    <!-- Drag-and-drop overwrite confirm (the DropZone's own flow), page-spanning. -->
    <views:ConfirmOverlay DataContext="{Binding Drop}" />
    </Grid>
</UserControl>
