<UserControl
    x:Class="LuaToolsGui.Views.ManageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:res="clr-namespace:LuaToolsGui.Resources"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:LuaToolsGui.ViewModels"
    xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
    d:DataContext="{d:DesignInstance Type=vm:ManageViewModel}"
    TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!-- Filter/sort ComboBox item display: shows the localized label while the bound value stays the
             English key (so ManageViewModel's switch/equality logic is untouched). -->
        <DataTemplate x:Key="FilterOptionTemplate">
            <TextBlock Text="{Binding Converter={StaticResource FilterOptionDisplay}}" />
        </DataTemplate>

        <!-- The depot/DLC breakdown (RowButtonStyle + DepotRowTemplate) moved to BuildsView, which shows
             it per build along with each depot's manifest pin. -->
    </UserControl.Resources>

    <Grid x:Name="Root" Margin="8,16,16,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock FontSize="22" FontWeight="Bold" Text="{x:Static res:Strings.Manage_Title}" />
            </StackPanel>
            <ui:Button
                Grid.Column="1"
                VerticalAlignment="Top"
                Command="{Binding RefreshCommand}"
                Content="{x:Static res:Strings.Manage_Refresh}"
                Icon="{ui:SymbolIcon ArrowSync24}" />
        </Grid>

        <!-- Search + Filters toggle -->
        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBox
                Icon="{ui:SymbolIcon Search24}"
                PlaceholderText="{x:Static res:Strings.Common_SearchPlaceholder}"
                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
            <ui:Button
                Grid.Column="1"
                Margin="8,0,0,0"
                Command="{Binding ToggleFilterPanelCommand}"
                Content="{x:Static res:Strings.Manage_Filters}"
                Icon="{ui:SymbolIcon Filter24}" />
        </Grid>

        <!-- Collapsible filter panel -->
        <Border
            Grid.Row="2"
            Margin="0,10,0,0"
            Padding="14"
            Background="#0DFFFFFF"
            BorderBrush="#1FFFFFFF"
            BorderThickness="1"
            CornerRadius="8"
            Visibility="{Binding IsFilterPanelOpen, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <!-- Dropdown row (left) + Clear button (right) -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <WrapPanel Orientation="Horizontal">
                        <StackPanel Margin="0,0,16,8">
                            <TextBlock FontSize="11" Foreground="#9ca3af" Text="{x:Static res:Strings.Manage_Filter_Type}" />
                            <ComboBox MinWidth="120" ItemTemplate="{StaticResource FilterOptionTemplate}" ItemsSource="{Binding TypeOptions}" SelectedItem="{Binding SelectedType}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,16,8">
                            <TextBlock FontSize="11" Foreground="#9ca3af" Text="{x:Static res:Strings.Manage_Filter_Genre}" />
                            <ComboBox MinWidth="140" ItemTemplate="{StaticResource FilterOptionTemplate}" ItemsSource="{Binding GenreOptions}" SelectedItem="{Binding SelectedGenre}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,16,8">
                            <TextBlock FontSize="11" Foreground="#9ca3af" Text="{x:Static res:Strings.Manage_Filter_Year}" />
                            <ComboBox MinWidth="90" ItemTemplate="{StaticResource FilterOptionTemplate}" ItemsSource="{Binding YearOptions}" SelectedItem="{Binding SelectedYear}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,16,8">
                            <TextBlock FontSize="11" Foreground="#9ca3af" Text="{x:Static res:Strings.Manage_Filter_Price}" />
                            <ComboBox MinWidth="90" ItemTemplate="{StaticResource FilterOptionTemplate}" ItemsSource="{Binding PriceOptions}" SelectedItem="{Binding SelectedPrice}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,16,8">
                            <TextBlock FontSize="11" Foreground="#9ca3af" Text="{x:Static res:Strings.Manage_Filter_Content}" />
                            <ComboBox MinWidth="120" ItemTemplate="{StaticResource FilterOptionTemplate}" ItemsSource="{Binding ContentOptions}" SelectedItem="{Binding SelectedContent}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,16,8">
                            <TextBlock FontSize="11" Foreground="#9ca3af" Text="{x:Static res:Strings.Manage_Filter_SortBy}" />
                            <ComboBox MinWidth="150" ItemTemplate="{StaticResource FilterOptionTemplate}" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort}" />
                        </StackPanel>
                    </WrapPanel>

                    <!-- Clear filters: right-aligned, vertically centered in the row. -->
                    <ui:Button
                        Grid.Column="1"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        Command="{Binding ClearFiltersCommand}"
                        Content="{x:Static res:Strings.Manage_ClearFilters}"
                        FontSize="11.5"
                        Icon="{ui:SymbolIcon Dismiss24}"
                        Visibility="{Binding HasActiveFilters, Converter={StaticResource BoolToVis}}" />
                </Grid>

                <!-- "Still fetching details" notice -->
                <StackPanel
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Visibility="{Binding HasPendingDetails, Converter={StaticResource BoolToVis}}">
                    <ui:ProgressRing
                        Width="14"
                        Height="14"
                        VerticalAlignment="Center"
                        IsIndeterminate="True" />
                    <TextBlock
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="11.5"
                        Foreground="#9ca3af"
                        Text="{Binding FilterPendingText}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Virtualized scrolling grid of all tiles -->
        <vwp:VirtualizingItemsControl
            x:Name="TileScroller"
            Grid.Row="3"
            Margin="0,14,0,0"
            ItemsSource="{Binding Items}"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            Visibility="{Binding ShowItems, Converter={StaticResource BoolToVis}}"
            VirtualizingPanel.CacheLengthUnit="Page"
            VirtualizingPanel.ScrollUnit="Pixel"
            VirtualizingPanel.VirtualizationMode="Standard">
            <vwp:VirtualizingItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <vwp:VirtualizingWrapPanel
                        Orientation="Horizontal"
                        SpacingMode="StartAndEndOnly"
                        StretchItems="False" />
                </ItemsPanelTemplate>
            </vwp:VirtualizingItemsControl.ItemsPanel>
            <vwp:VirtualizingItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border
                        x:Name="TileRoot"
                        Width="248"
                        Height="208"
                        Margin="0,0,12,12"
                        Background="#0DFFFFFF"
                        BorderBrush="#14FFFFFF"
                        BorderThickness="1"
                        Cursor="Hand"
                        CornerRadius="10"
                        DataContextChanged="Tile_DataContextChanged"
                        Loaded="Tile_Loaded"
                        MouseLeftButtonUp="Tile_Click">
                        <Border.ContextMenu>
                            <ContextMenu>
                                <MenuItem
                                    Command="{Binding PlacementTarget.Tag.OpenDetailCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                    CommandParameter="{Binding}"
                                    Header="{x:Static res:Strings.Manage_Action_ViewDetails}"
                                    Icon="{ui:SymbolIcon Info24}" />
                                <MenuItem
                                    Command="{Binding PlacementTarget.Tag.ManageBuildCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                    CommandParameter="{Binding}"
                                    Header="{x:Static res:Strings.Manage_Action_ManageBuild}"
                                    Icon="{ui:SymbolIcon BranchFork24}" />
                                <Separator />
                                <MenuItem
                                    Command="{Binding PlacementTarget.Tag.UpdateCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                    CommandParameter="{Binding}"
                                    Header="{x:Static res:Strings.Manage_Action_Update}"
                                    Icon="{ui:SymbolIcon ArrowDownload24}" />
                                <MenuItem
                                    Command="{Binding PlacementTarget.Tag.RemoveDrmCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                    CommandParameter="{Binding}"
                                    Header="{x:Static res:Strings.Manage_Action_RemoveDrm}"
                                    Icon="{ui:SymbolIcon WrenchScrewdriver24}" />
                                <Separator />
                                <MenuItem
                                    Command="{Binding PlacementTarget.Tag.OpenStorePageCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                    CommandParameter="{Binding}"
                                    Header="{x:Static res:Strings.Manage_Action_OpenStore}"
                                    Icon="{ui:SymbolIcon Globe24}" />
                                <MenuItem
                                    Command="{Binding PlacementTarget.Tag.OpenInSteamCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                    CommandParameter="{Binding}"
                                    Header="{x:Static res:Strings.Manage_Action_OpenInSteam}"
                                    Icon="{ui:SymbolIcon Open24}" />
                                <MenuItem
                                    Command="{Binding PlacementTarget.Tag.RevealFileCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                    CommandParameter="{Binding}"
                                    Header="{x:Static res:Strings.Manage_Action_Reveal}"
                                    Icon="{ui:SymbolIcon FolderOpen24}" />
                                <MenuItem
                                    Command="{Binding PlacementTarget.Tag.CopyAppIdCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                    CommandParameter="{Binding}"
                                    Header="{x:Static res:Strings.Manage_Action_CopyAppId}"
                                    Icon="{ui:SymbolIcon Copy24}" />
                                <Separator />
                                <MenuItem
                                    Command="{Binding PlacementTarget.Tag.DeleteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                    CommandParameter="{Binding}"
                                    Foreground="#f87171"
                                    Header="{x:Static res:Strings.Manage_DeleteThisLua}"
                                    Icon="{ui:SymbolIcon Delete24}" />
                            </ContextMenu>
                        </Border.ContextMenu>
                        <!-- Tag carries the page VM so the ContextMenu (outside the visual tree) can reach its commands. -->
                        <Border.Tag>
                            <Binding ElementName="Root" Path="DataContext" />
                        </Border.Tag>
                        <StackPanel>
                            <!-- Cover (with a hover delete button) -->
                            <Border
                                Height="116"
                                Background="#11FFFFFF"
                                CornerRadius="10,10,0,0"
                                ClipToBounds="True">
                                <Grid>
                                    <Image Source="{Binding Cover}" Stretch="UniformToFill" />
                                    <!-- Selection toggle: matches the delete button; shows on hover or while selected -->
                                    <ui:Button
                                        Margin="6,6,0,0"
                                        Padding="6"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Click="ToggleSelect_Click"
                                        Icon="{ui:SymbolIcon Checkmark24}"
                                        ToolTip="{x:Static res:Strings.Manage_Select}">
                                        <ui:Button.Style>
                                            <Style BasedOn="{StaticResource {x:Type ui:Button}}" TargetType="ui:Button">
                                                <Setter Property="Opacity" Value="0" />
                                                <Setter Property="Background" Value="#cc14161c" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMouseOver, ElementName=TileRoot}" Value="True">
                                                        <Setter Property="Opacity" Value="1" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Opacity" Value="1" />
                                                        <Setter Property="Background" Value="#cc16a34a" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:Button.Style>
                                    </ui:Button>
                                    <ui:Button
                                        Margin="0,6,6,0"
                                        Padding="6"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Background="#cc1f1417"
                                        Command="{Binding DataContext.DeleteCommand, ElementName=Root}"
                                        CommandParameter="{Binding}"
                                        Icon="{ui:SymbolIcon Delete24}"
                                        ToolTip="{x:Static res:Strings.Manage_DeleteThisLua}">
                                        <ui:Button.Style>
                                            <Style BasedOn="{StaticResource {x:Type ui:Button}}" TargetType="ui:Button">
                                                <Setter Property="Opacity" Value="0" />
                                                <Style.Triggers>
                                                    <!-- Reveal on tile hover -->
                                                    <DataTrigger Binding="{Binding IsMouseOver, ElementName=TileRoot}" Value="True">
                                                        <Setter Property="Opacity" Value="1" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:Button.Style>
                                    </ui:Button>
                                </Grid>
                            </Border>
                            <!-- Info -->
                            <StackPanel Margin="12,10,12,12">
                                <TextBlock
                                    Height="36"
                                    FontSize="13.5"
                                    FontWeight="SemiBold"
                                    Text="{Binding Name}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    FontSize="11.5"
                                    Foreground="#6b7280"
                                    Text="{Binding AppId, StringFormat={x:Static res:Strings.Common_AppId}}" />
                                <TextBlock
                                    Margin="0,2,0,0"
                                    FontSize="11"
                                    Foreground="#4b5563"
                                    Text="{Binding AddedReleaseLabel}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </vwp:VirtualizingItemsControl.ItemTemplate>
        </vwp:VirtualizingItemsControl>

        <!-- Loading state (first run downloads the Steam app list) -->
        <StackPanel
            Grid.Row="3"
            Margin="0,40,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Orientation="Horizontal"
            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
            <ui:ProgressRing
                Width="20"
                Height="20"
                IsIndeterminate="True" />
            <TextBlock
                Margin="10,0,0,0"
                VerticalAlignment="Center"
                FontSize="13"
                Foreground="#9ca3af"
                Text="{x:Static res:Strings.Manage_LoadingGames}" />
        </StackPanel>

        <!-- Empty state -->
        <StackPanel
            Grid.Row="3"
            Margin="0,40,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
            <ui:SymbolIcon
                HorizontalAlignment="Center"
                FontSize="32"
                Foreground="#4b5563"
                Symbol="Games24" />
            <TextBlock
                Margin="0,10,0,0"
                HorizontalAlignment="Center"
                FontSize="13"
                Foreground="#9ca3af"
                Text="{Binding EmptyMessage}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
        </StackPanel>

        <!-- Selection action bar: floats at the bottom while one or more tiles are selected -->
        <Border
            Grid.Row="3"
            Margin="0,0,0,16"
            Padding="8,8,12,8"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Background="#1f1f27"
            BorderBrush="#33FFFFFF"
            BorderThickness="1"
            CornerRadius="12"
            Visibility="{Binding IsSelecting, Converter={StaticResource BoolToVis}}">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="18"
                    Opacity="0.5"
                    ShadowDepth="2"
                    Color="Black" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <TextBlock
                    Margin="8,0,12,0"
                    VerticalAlignment="Center"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="#e5e7eb"
                    Text="{Binding SelectionLabel}" />
                <ui:Button
                    Margin="0,0,8,0"
                    Command="{Binding ClearSelectionCommand}"
                    Content="{x:Static res:Strings.Manage_Clear}"
                    Icon="{ui:SymbolIcon Dismiss24}" />
                <ui:Button
                    Appearance="Danger"
                    Command="{Binding DeleteSelectedCommand}"
                    Content="{x:Static res:Strings.Manage_DeleteSelected}"
                    Icon="{ui:SymbolIcon Delete24}" />
            </StackPanel>
        </Border>

        <!-- Pager bar: page numbers centered across the full width (so they sit under the grid's middle),
             with results-per-page overlaid at the right. Shown once tiles are present. -->
        <Grid
            Grid.Row="4"
            Margin="0,12,0,2"
            Visibility="{Binding ShowItems, Converter={StaticResource BoolToVis}}">

            <!-- Centered group: ‹ prev | page numbers (fixed-width zone) | › next. The numbers live in a
                 fixed-width column so ‹/› never move (you can rapid-click them without re-aiming), and
                 the whole group is centered on the bar (independent of the right-side dropdown). -->
            <Grid
                HorizontalAlignment="Center"
                Visibility="{Binding ShowPager, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="320" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:Button
                    Grid.Column="0"
                    Margin="2,0"
                    Padding="8,4"
                    Command="{Binding PrevPageCommand}"
                    Content="‹"
                    FontSize="14"
                    IsEnabled="{Binding CanGoPrev}" />
                <ItemsControl Grid.Column="1" HorizontalAlignment="Center" ItemsSource="{Binding PageNumbers}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <!-- Ellipsis gap (sentinel 0): non-clickable "…" -->
                                <TextBlock
                                    Margin="6,0"
                                    VerticalAlignment="Center"
                                    Foreground="#6b7280"
                                    Text="…">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <!-- Page-number button -->
                                <ui:Button
                                    Margin="2,0"
                                    Padding="8,4"
                                    Command="{Binding DataContext.GoToPageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"
                                    Content="{Binding}"
                                    FontSize="13">
                                    <ui:Button.Style>
                                        <Style BasedOn="{StaticResource {x:Type ui:Button}}" TargetType="ui:Button">
                                            <Style.Triggers>
                                                <!-- Hide the button for the ellipsis sentinel (0) -->
                                                <DataTrigger Binding="{Binding}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <!-- Highlight the active page -->
                                                <DataTrigger Value="True">
                                                    <DataTrigger.Binding>
                                                        <MultiBinding Converter="{StaticResource EqualityMulti}">
                                                            <Binding />
                                                            <Binding Path="DataContext.CurrentPage" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                        </MultiBinding>
                                                    </DataTrigger.Binding>
                                                    <Setter Property="Appearance" Value="Primary" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:Button.Style>
                                </ui:Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ui:Button
                    Grid.Column="2"
                    Margin="2,0"
                    Padding="8,4"
                    Command="{Binding NextPageCommand}"
                    Content="›"
                    FontSize="14"
                    IsEnabled="{Binding CanGoNext}" />
            </Grid>

            <!-- Right: results-per-page (overlaid at the right edge, doesn't shift the centered pager) -->
            <StackPanel
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <TextBlock
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    FontSize="11.5"
                    Foreground="#9ca3af"
                    Text="{x:Static res:Strings.Manage_ResultsPerPage}" />
                <ComboBox
                    MinWidth="72"
                    ItemTemplate="{StaticResource FilterOptionTemplate}"
                    ItemsSource="{Binding PageSizeOptions}"
                    SelectedItem="{Binding SelectedPageSize}" />
            </StackPanel>
        </Grid>

        <!-- Detail flyout: dim scrim + slide-in panel from the right -->
        <Grid
            Grid.Row="0"
            Grid.RowSpan="5"
            Margin="-8,-16,-16,-8"
            Background="#80000000"
            Visibility="{Binding IsDetailOpen, Converter={StaticResource BoolToVis}}">
            <!-- Click the scrim to dismiss -->
            <Border Background="Transparent" MouseLeftButtonUp="Scrim_Click" />
            <Border
                Width="380"
                HorizontalAlignment="Right"
                Background="#1c1c22"
                BorderBrush="#22FFFFFF"
                BorderThickness="1,0,0,0">
                <Grid Margin="20" DataContext="{Binding SelectedTile}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Close -->
                    <ui:Button
                        Grid.Row="0"
                        HorizontalAlignment="Right"
                        Appearance="Transparent"
                        Command="{Binding DataContext.CloseDetailCommand, ElementName=Root}"
                        Icon="{ui:SymbolIcon Dismiss24}" />

                    <!-- Cover + title -->
                    <StackPanel Grid.Row="1" Margin="0,4,0,0">
                        <Border
                            Height="170"
                            Background="#11FFFFFF"
                            ClipToBounds="True"
                            CornerRadius="10">
                            <Image Source="{Binding Cover}" Stretch="UniformToFill" />
                        </Border>
                        <TextBlock
                            Margin="0,12,0,0"
                            FontSize="18"
                            FontWeight="Bold"
                            Text="{Binding Name}"
                            TextWrapping="Wrap" />
                        <Button
                            Margin="0,4,0,0"
                            HorizontalAlignment="Left"
                            Background="Transparent"
                            BorderThickness="0"
                            Command="{Binding DataContext.CopyAppIdCommand, ElementName=Root}"
                            CommandParameter="{Binding}"
                            Cursor="Hand"
                            ToolTip="{x:Static res:Strings.Manage_CopyAppIdTip}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    FontSize="12"
                                    Foreground="#9ca3af"
                                    Text="{Binding AppId, StringFormat={x:Static res:Strings.Common_AppId}}" />
                                <ui:SymbolIcon
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="#6b7280"
                                    Symbol="Copy24" />
                            </StackPanel>
                        </Button>
                        <TextBlock
                            Margin="0,2,0,0"
                            FontSize="12"
                            Foreground="#6b7280"
                            Text="{Binding AddedReleaseLabel}" />
                    </StackPanel>

                    <!-- Game info, straight from the cached appdetails blob (no network). The depot/DLC
                         breakdown that used to sit here lives on the Builds page now. Scrolls on its own
                         so a long blurb can't push the Actions block off the panel. -->
                    <ScrollViewer
                        Grid.Row="2"
                        Margin="0,14,0,0"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel
                            Margin="0,0,6,0"
                            DataContext="{Binding DataContext.Overview, ElementName=Root}">
                            <!-- Hidden until there's room for a few readable lines. This block sits in
                                 the flyout's star row, so at the default window height it gets ~40px and
                                 renders one clipped line of blurb, which just looks broken.

                                 The height comes from the parent ScrollViewer, not from this panel:
                                 gating an element on its OWN ActualHeight is circular (see the
                                 converter). The ScrollViewer is stretched by the star row, so its height
                                 doesn't move when this child collapses. -->
                            <StackPanel.Visibility>
                                <MultiBinding Converter="{StaticResource MinHeightToVis}" ConverterParameter="100">
                                    <Binding Path="HasAnything" />
                                    <Binding Path="ActualHeight" RelativeSource="{RelativeSource AncestorType=ScrollViewer}" />
                                </MultiBinding>
                            </StackPanel.Visibility>
                            <TextBlock
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="#d1d5db"
                                Text="{x:Static res:Strings.Manage_AboutHeader}" />
                            <TextBlock
                                Margin="0,6,0,0"
                                FontSize="12"
                                Foreground="#9ca3af"
                                LineHeight="17"
                                Text="{Binding ShortDescription}"
                                TextWrapping="Wrap"
                                Visibility="{Binding HasDescription, Converter={StaticResource BoolToVis}}" />

                            <!-- Developer / publisher. The publisher line only renders when it's a
                                 different studio (identical for ~40% of apps). -->
                            <Grid Margin="0,12,0,0" Visibility="{Binding HasDeveloper, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    FontSize="11.5"
                                    Foreground="#6b7280"
                                    Text="{x:Static res:Strings.Manage_Info_Developer}" />
                                <TextBlock
                                    Grid.Column="1"
                                    FontSize="11.5"
                                    Foreground="#d1d5db"
                                    Text="{Binding DeveloperLabel}"
                                    TextWrapping="Wrap" />
                            </Grid>
                            <Grid Margin="0,4,0,0" Visibility="{Binding HasDistinctPublisher, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    FontSize="11.5"
                                    Foreground="#6b7280"
                                    Text="{x:Static res:Strings.Manage_Info_Publisher}" />
                                <TextBlock
                                    Grid.Column="1"
                                    FontSize="11.5"
                                    Foreground="#d1d5db"
                                    Text="{Binding PublisherLabel}"
                                    TextWrapping="Wrap" />
                            </Grid>

                            <!-- Genre pills -->
                            <ItemsControl
                                Margin="0,12,0,0"
                                ItemsSource="{Binding Genres}"
                                Visibility="{Binding HasGenres, Converter={StaticResource BoolToVis}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            Margin="0,0,6,6"
                                            Padding="7,2"
                                            Background="#2a2440"
                                            CornerRadius="4">
                                            <TextBlock
                                                FontSize="10.5"
                                                FontWeight="SemiBold"
                                                Foreground="#c4b5fd"
                                                Text="{Binding}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Actions -->
                    <StackPanel Grid.Row="3" Margin="0,16,0,0">
                        <TextBlock
                            Margin="0,0,0,8"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="#d1d5db"
                            Text="{x:Static res:Strings.Manage_ActionsHeader}" />

                        <!-- Steamless progress (only while running) -->
                        <ProgressBar
                            Height="3"
                            Margin="0,0,0,8"
                            IsIndeterminate="{Binding DataContext.IsProgressIndeterminate, ElementName=Root}"
                            Maximum="100"
                            Value="{Binding DataContext.Progress, ElementName=Root}"
                            Visibility="{Binding DataContext.IsBusy, ElementName=Root, Converter={StaticResource BoolToVis}}" />

                        <ui:Button
                            HorizontalAlignment="Stretch"
                            Appearance="Primary"
                            Command="{Binding DataContext.ManageBuildCommand, ElementName=Root}"
                            CommandParameter="{Binding}"
                            Content="{x:Static res:Strings.Manage_Action_ManageBuild}"
                            Icon="{ui:SymbolIcon BranchFork24}" />
                        <ui:Button
                            Margin="0,8,0,0"
                            HorizontalAlignment="Stretch"
                            Command="{Binding DataContext.UpdateCommand, ElementName=Root}"
                            CommandParameter="{Binding}"
                            Content="{x:Static res:Strings.Manage_Action_Update}"
                            Icon="{ui:SymbolIcon ArrowDownload24}"
                            IsEnabled="{Binding DataContext.NotBusy, ElementName=Root}" />
                        <ui:Button
                            Margin="0,8,0,0"
                            HorizontalAlignment="Stretch"
                            Command="{Binding DataContext.EditLaunchOptionsCommand, ElementName=Root}"
                            CommandParameter="{Binding}"
                            Content="{x:Static res:Strings.Manage_Action_LaunchOptions}"
                            Icon="{ui:SymbolIcon Play24}" />
                        <ui:Button
                            Margin="0,8,0,0"
                            HorizontalAlignment="Stretch"
                            Command="{Binding DataContext.ManageAchievementsCommand, ElementName=Root}"
                            CommandParameter="{Binding}"
                            Content="{x:Static res:Strings.Nav_Achievements}"
                            Icon="{ui:SymbolIcon Trophy24}" />
                        <ui:Button
                            Margin="0,8,0,0"
                            HorizontalAlignment="Stretch"
                            Command="{Binding DataContext.RemoveDrmCommand, ElementName=Root}"
                            CommandParameter="{Binding}"
                            Content="{x:Static res:Strings.Manage_Action_RemoveDrm}"
                            Icon="{ui:SymbolIcon WrenchScrewdriver24}"
                            IsEnabled="{Binding DataContext.NotBusy, ElementName=Root}" />
                        <UniformGrid Margin="0,8,0,0" Columns="2" Rows="2">
                            <ui:Button
                                Margin="0,0,4,4"
                                HorizontalAlignment="Stretch"
                                Command="{Binding DataContext.OpenStorePageCommand, ElementName=Root}"
                                CommandParameter="{Binding}"
                                Content="{x:Static res:Strings.Manage_Action_OpenStore}"
                                Icon="{ui:SymbolIcon Globe24}" />
                            <ui:Button
                                Margin="4,0,0,4"
                                HorizontalAlignment="Stretch"
                                Command="{Binding DataContext.OpenInSteamCommand, ElementName=Root}"
                                CommandParameter="{Binding}"
                                Content="{x:Static res:Strings.Manage_Action_OpenInSteam}"
                                Icon="{ui:SymbolIcon Open24}" />
                            <ui:Button
                                Margin="0,4,4,0"
                                HorizontalAlignment="Stretch"
                                Command="{Binding DataContext.RevealFileCommand, ElementName=Root}"
                                CommandParameter="{Binding}"
                                Content="{x:Static res:Strings.Manage_Action_Reveal}"
                                Icon="{ui:SymbolIcon FolderOpen24}" />
                            <ui:Button
                                Margin="4,4,0,0"
                                HorizontalAlignment="Stretch"
                                Command="{Binding DataContext.CopyAppIdCommand, ElementName=Root}"
                                CommandParameter="{Binding}"
                                Content="{x:Static res:Strings.Manage_Action_CopyAppId}"
                                Icon="{ui:SymbolIcon Copy24}" />
                        </UniformGrid>
                        <ui:Button
                            Margin="0,8,0,0"
                            HorizontalAlignment="Stretch"
                            Command="{Binding DataContext.DeleteCommand, ElementName=Root}"
                            CommandParameter="{Binding}"
                            Content="{x:Static res:Strings.Manage_DeleteThisLua}"
                            Foreground="#f87171"
                            Icon="{ui:SymbolIcon Delete24}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
