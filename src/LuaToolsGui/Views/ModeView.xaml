<UserControl
    x:Class="LuaToolsGui.Views.ModeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:res="clr-namespace:LuaToolsGui.Resources"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:LuaToolsGui.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:ModeViewModel}"
    TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <!-- Fixed bottom dock (separator + CloudRedirect add-on + progress) -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="760" Margin="8,16,16,8">

                <!-- Header -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock
                            FontSize="22"
                            FontWeight="Bold"
                            Text="{x:Static res:Strings.Mode_Title}" />
                        <TextBlock
                            Margin="0,2,0,0"
                            FontSize="13"
                            Foreground="#9ca3af"
                            Text="{x:Static res:Strings.Mode_Subtitle}" />
                    </StackPanel>
                    <ui:Button
                        Grid.Column="1"
                        VerticalAlignment="Top"
                        Command="{Binding CheckForUpdatesCommand}"
                        Content="{x:Static res:Strings.Mode_CheckForUpdates}"
                        Icon="{ui:SymbolIcon ArrowSync24}"
                        IsEnabled="{Binding NotBusy}" />
                </Grid>

                <!-- Mode cards -->
                <ItemsControl Margin="0,18,0,0" ItemsSource="{Binding Cards}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Margin="0,0,0,12"
                                Padding="18"
                                Background="#0DFFFFFF"
                                BorderBrush="#1FFFFFFF"
                                BorderThickness="1"
                                CornerRadius="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon
                                                VerticalAlignment="Center"
                                                Foreground="#a78bfa"
                                                Symbol="Wrench24" />
                                            <TextBlock
                                                Margin="10,0,0,0"
                                                VerticalAlignment="Center"
                                                FontSize="15"
                                                FontWeight="SemiBold"
                                                Text="{Binding Title}" />
                                            <!-- Active: green badge with checkmark. -->
                                            <Border
                                                Margin="10,0,0,0"
                                                Padding="7,2"
                                                VerticalAlignment="Center"
                                                Background="#2022c55e"
                                                CornerRadius="4"
                                                Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon
                                                        VerticalAlignment="Center"
                                                        FontSize="11"
                                                        Foreground="#4ade80"
                                                        Symbol="Checkmark24" />
                                                    <TextBlock
                                                        Margin="4,0,0,0"
                                                        VerticalAlignment="Center"
                                                        FontSize="10.5"
                                                        FontWeight="SemiBold"
                                                        Foreground="#4ade80"
                                                        Text="{x:Static res:Strings.Mode_Active}" />
                                                </StackPanel>
                                            </Border>
                                            <!-- Recommended: blue badge to steer users to the best option. -->
                                            <Border
                                                Margin="6,0,0,0"
                                                Padding="7,2"
                                                VerticalAlignment="Center"
                                                Background="#202563eb"
                                                CornerRadius="4"
                                                Visibility="{Binding IsRecommended, Converter={StaticResource BoolToVis}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon
                                                        VerticalAlignment="Center"
                                                        FontSize="10"
                                                        Foreground="#60a5fa"
                                                        Symbol="Star24" />
                                                    <TextBlock
                                                        Margin="4,0,0,0"
                                                        VerticalAlignment="Center"
                                                        FontSize="10.5"
                                                        FontWeight="SemiBold"
                                                        Foreground="#60a5fa"
                                                        Text="{x:Static res:Strings.Mode_Recommended}" />
                                                </StackPanel>
                                            </Border>
                                            <!-- Nightly: amber "Experimental" badge. -->
                                            <Border
                                                Margin="6,0,0,0"
                                                Padding="7,2"
                                                VerticalAlignment="Center"
                                                Background="#20f59e0b"
                                                CornerRadius="4"
                                                Visibility="{Binding IsExperimental, Converter={StaticResource BoolToVis}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon
                                                        VerticalAlignment="Center"
                                                        FontSize="10"
                                                        Foreground="#fbbf24"
                                                        Symbol="Warning24" />
                                                    <TextBlock
                                                        Margin="4,0,0,0"
                                                        VerticalAlignment="Center"
                                                        FontSize="10.5"
                                                        FontWeight="SemiBold"
                                                        Foreground="#fbbf24"
                                                        Text="{x:Static res:Strings.Mode_Experimental}" />
                                                </StackPanel>
                                            </Border>
                                            <!-- Nightly: purple "CloudRedirect Support" badge. -->
                                            <Border
                                                Margin="6,0,0,0"
                                                Padding="7,2"
                                                VerticalAlignment="Center"
                                                Background="#207c3aed"
                                                CornerRadius="4"
                                                Visibility="{Binding SupportsCloudRedirect, Converter={StaticResource BoolToVis}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon
                                                        VerticalAlignment="Center"
                                                        FontSize="10"
                                                        Foreground="#c4b5fd"
                                                        Symbol="Cloud24" />
                                                    <TextBlock
                                                        Margin="4,0,0,0"
                                                        VerticalAlignment="Center"
                                                        FontSize="10.5"
                                                        FontWeight="SemiBold"
                                                        Foreground="#c4b5fd"
                                                        Text="{x:Static res:Strings.Mode_CloudRedirectSupport}" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock
                                            Margin="0,6,0,0"
                                            FontSize="12"
                                            Foreground="#7c8593"
                                            Text="{Binding Description}"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            Margin="0,6,0,0"
                                            FontSize="12.5"
                                            Foreground="#9ca3af"
                                            Text="{Binding StatusText}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel
                                        Grid.Column="1"
                                        VerticalAlignment="Center">
                                        <!-- Hidden on the active Custom card: nothing to install or update there. -->
                                        <ui:Button
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            Command="{Binding DataContext.InstallCommand, ElementName=Root}"
                                            CommandParameter="{Binding}"
                                            Content="{Binding ButtonText}"
                                            IsEnabled="{Binding DataContext.NotBusy, ElementName=Root}"
                                            Visibility="{Binding ShowActionButton, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>

        <!-- Fixed bottom dock: separator + CloudRedirect add-on + shared progress. -->
        <StackPanel Grid.Row="1" MaxWidth="760" Margin="8,0,16,16">

                <!-- Divider between the scrolling mode cards and the docked add-on. -->
                <Border Height="1" Margin="0,0,0,14" Background="#1FFFFFFF" />

                <!-- CloudRedirect add-on: a feature of the Nightly BST build. Locked (dimmed, buttons
                      disabled) unless BetterSteamTools Nightly is the active mode. -->
                <Border
                    Margin="0,0,0,0"
                    Padding="18"
                    Background="#0DFFFFFF"
                    BorderBrush="#1FFFFFFF"
                    BorderThickness="1"
                    CornerRadius="10">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CloudRedirectUnlocked}" Value="False">
                                    <Setter Property="Opacity" Value="0.55" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon
                                    VerticalAlignment="Center"
                                    Foreground="#38bdf8"
                                    Symbol="Cloud24" />
                                <TextBlock
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    Text="CloudRedirect" />
                            </StackPanel>
                            <TextBlock
                                Margin="0,6,0,0"
                                FontSize="12"
                                Foreground="#7c8593"
                                Text="{x:Static res:Strings.Mode_CloudRedirect_AddonDesc}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Margin="0,6,0,0"
                                FontSize="12.5"
                                Foreground="#9ca3af"
                                Text="{Binding CloudRedirectStatusText}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <ui:Button
                                MinWidth="96"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Command="{Binding ToggleCloudRedirectCommand}"
                                Content="{Binding CloudRedirectToggleText}"
                                IsEnabled="{Binding CanUseCloudRedirect}" />
                            <ui:Button
                                Margin="0,8,0,0"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Command="{Binding UpdateCloudRedirectCommand}"
                                Content="{x:Static res:Strings.Mode_Btn_Update}"
                                Icon="{ui:SymbolIcon ArrowSync24}"
                                IsEnabled="{Binding CanUseCloudRedirect}"
                                Visibility="{Binding ShowCloudRedirectUpdate, Converter={StaticResource BoolToVis}}" />
                            <ui:Button
                                Margin="0,8,0,0"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Command="{Binding ManageCloudRedirectCommand}"
                                Content="{x:Static res:Strings.Mode_CloudRedirect_Manage}"
                                Icon="{ui:SymbolIcon Cloud24}"
                                IsEnabled="{Binding CanUseCloudRedirect}"
                                Visibility="{Binding ShowCloudRedirectManage, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Shared progress while installing/switching -->
                <ProgressBar
                    Height="6"
                    Margin="0,2,0,0"
                    IsIndeterminate="{Binding IsProgressIndeterminate}"
                    Maximum="100"
                    Value="{Binding Progress}"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />

        </StackPanel>

        <!-- Steam-shutdown confirmation overlay (covers the whole page, both rows) -->
        <Grid
            Grid.Row="0"
            Grid.RowSpan="2"
            Background="#99000000"
            Visibility="{Binding IsConfirming, Converter={StaticResource BoolToVis}}">
            <Border
                MaxWidth="420"
                Margin="8"
                Padding="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#1c1c22"
                BorderBrush="#33FFFFFF"
                BorderThickness="1"
                CornerRadius="12">
                <StackPanel>
                    <TextBlock
                        FontSize="16"
                        FontWeight="Bold"
                        Text="{Binding ConfirmTitle}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Margin="0,8,0,0"
                        FontSize="12.5"
                        Foreground="#9ca3af"
                        Text="{x:Static res:Strings.Mode_Confirm_Body}"
                        TextWrapping="Wrap" />
                    <StackPanel
                        Margin="0,16,0,0"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                        <ui:Button
                            Margin="0,0,8,0"
                            Command="{Binding CancelConfirmCommand}"
                            Content="{x:Static res:Strings.Mode_Cancel}" />
                        <ui:Button
                            Appearance="Primary"
                            Command="{Binding ConfirmInstallCommand}"
                            Content="{x:Static res:Strings.Mode_CloseSteamContinue}"
                            Icon="{ui:SymbolIcon Power24}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
